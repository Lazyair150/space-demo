[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/industrial/world_v2/SpaceHangarScreen.gd" id="1_screen"]
[ext_resource type="Script" path="res://scripts/industrial/world_v2/SpaceHangarPreparation.gd" id="2_preparation"]
