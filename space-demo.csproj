<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpaceDemo</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Override for CI/workspaces that do not use the default sibling checkout layout. -->
    <JarSystemWorldV2BridgeProject Condition="'$(JarSystemWorldV2BridgeProject)' == ''">$(MSBuildThisFileDirectory)..\jar-system-dotnet\hosts\godot\WorldV2Bridge\JarSystem.WorldV2Bridge.csproj</JarSystemWorldV2BridgeProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build against the exact Core PR branch during cross-repository integration. -->
    <ProjectReference Include="$(JarSystemWorldV2BridgeProject)" />
  </ItemGroup>

</Project>
